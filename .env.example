PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
UPLOAD_DIR=uploads
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/dbname
MONGODB_DB=sctsinstitute

# Email Configuration (SMTP) — required for registration confirmation / welcome emails
# Production: set these in your host’s environment UI, OR place a real backend/.env on the server
# (the app loads backend/.env in all environments when the file exists; host env wins if both are set).
# For testing, use Mailtrap: https://mailtrap.io
# EMAIL_HOST=smtp.mailtrap.io
# EMAIL_PORT=2525
# EMAIL_SECURE=false
# EMAIL_USER=your_mailtrap_username
# EMAIL_PASS=your_mailtrap_password
# EMAIL_FROM=noreply@yourdomain.com
# FRONTEND_URL=http://localhost:5173

# Production SMTP Example (Gmail)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_app_password
# EMAIL_FROM="SCTS Institute <noreply@yourdomain.com>"
# FRONTEND_URL=https://yourdomain.com

# Hostinger (matches hPanel: Outgoing SMTP — not IMAP/POP; those are for Outlook/phone only)
# smtp.hostinger.com · 465 · SSL/TLS  →  nodemailer needs implicit TLS:
# EMAIL_HOST=smtp.hostinger.com
# EMAIL_PORT=465
# EMAIL_SECURE=true
# EMAIL_USER=full@yourdomain.com
# EMAIL_PASS=your_mailbox_password
# EMAIL_FROM="Your Name <full@yourdomain.com>"
# FRONTEND_URL=https://yourdomain.com
# If the password has special characters (#, @, etc.), URL-encode it or wrap carefully in .env
#
# "Connection timeout" on the server: many containers block outbound SMTP — use Resend instead.
# Wrong TLS also fails: port 465 → EMAIL_SECURE=true ; port 587 → EMAIL_SECURE=false
# Try forcing IPv4: EMAIL_SMTP_IPV4=1  (or EMAIL_SMTP_FAMILY=4)
# EMAIL_SMTP_TIMEOUT_MS=60000

# ── RECOMMENDED: Resend HTTP API (bypasses SMTP port blocks) ──────────────
# 1. Sign up free: https://resend.com  (100 emails/day)
# 2. Add + verify your domain (sctsinstitute.com) in their dashboard
# 3. Copy the API key below — no EMAIL_HOST/PORT/SECURE needed
# RESEND_API_KEY=re_xxxxxxxxxxxx
# EMAIL_FROM="SCTS Institute <info@sctsinstitute.com>"
# FRONTEND_URL=https://sctsinstitute.com
# If RESEND_API_KEY is set, all emails go over HTTPS (port 443) — works everywhere.
# If not set, the app falls back to SMTP (EMAIL_HOST/USER/PASS).

# Optional: protects GET /test-email in production (?secret=...)
# TEST_EMAIL_SECRET=a-long-random-string

# ── Admin alert on new user signup (ADMIN_EMAIL) ────────────────────────────
# Uses the SAME email transport as welcome mail: Resend if RESEND_API_KEY is set
# (recommended on Railway — outbound SMTP is often blocked). Otherwise SMTP.
# ADMIN_EMAIL=admin@yourdomain.com
#
# On Railway: set ADMIN_EMAIL + RESEND_API_KEY + EMAIL_FROM (verified domain).
# Optional legacy: MAIL_USER / MAIL_PASS only used if you call old SMTP-only code paths.