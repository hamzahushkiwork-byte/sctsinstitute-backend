{
  "info": {
    "_postman_id": "scts-institute-api-collection",
    "name": "SCTS Institute API",
    "description": "Import this file in Postman (Import → File). Then import an environment from the same `postman/` folder and select it in the top-right.\n\n**Dynamic base URL:** every request uses `{{baseUrl}}`. Change `baseUrl` in the active environment (local vs staging vs production) without editing requests.\n\n**Auth:** set `userEmail` and `userPassword` in the environment, run **Auth → Login**. Tests on that request save `accessToken` and `refreshToken` to the environment. Admin and protected folders send `Authorization: Bearer {{accessToken}}`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
